# Beacon Backend — variables de entorno
# Local: copiar a .env y ajustar. Railway: definir en el dashboard del servicio.

JWT_SECRET=<your_jwt_secret>
# Note: Mínimo 64 caracteres. Obligatorio.

PORT=3000
# Note: Puerto HTTP del API. Railway suele inyectar PORT automáticamente.

DB_HOST=localhost
# Note: Local: localhost. Railway: host del plugin Postgres (ej. PGHOST / valor del dashboard).

DB_PORT=5433
# Note: Local: 5433 (puerto del docker compose). Railway: puerto del plugin Postgres (suele ser 5432).

DB_USER=beacon
# Note: Usuario de PostgreSQL.

DB_PASSWORD=<your_postgres_password>
# Note: Contraseña de PostgreSQL.

DB_NAME=beacon
# Note: Nombre de la base de datos.

DB_SYNC=true
# Note: true en local (TypeORM crea/actualiza el schema). false en Railway/producción (usar migraciones).

FRONTEND_URL=http://localhost:5173
# Note: Origen exacto del frontend (CORS + cookies).
# Local: http://localhost:5173
# Producción (Vercel): https://<tu-proyecto>.vercel.app

REFRESH_COOKIE_SECURE=false
# Note: false en HTTP local. true en HTTPS (Vercel + Railway).
# Con true, la cookie usa SameSite=None para orígenes cruzados.

RESEND_API_KEY=<your_resend_api_key>
# Note: API key de Resend para envío de correos.

EMAIL_FROM=<verified_from_address>
# Note: Remitente verificado, ej. "Beacon <noreply@tu-dominio.com>".

ADMIN_INITIAL_EMAIL=<your_email>
# Note: Email del administrador creado por la migración inicial.

ADMIN_INITIAL_PASSWORD=<your_password>
# Note: Contraseña del admin inicial (8-16 caracteres, al menos una letra y un número).

ADMIN_INITIAL_FIRST_NAME=<your_first_name>
# Note: Nombre del administrador inicial.

ADMIN_INITIAL_LAST_NAME=<your_last_name>
# Note: Apellido del administrador inicial.

# Make sure to keep the .env file private and do not share it publicly.
